{
  "title": "猪谕文库",
  "english": "PORCINE ORACLE LIBRARY",
  "version": 1,
  "entries": [
    {
      "id": "O001",
      "tag": "行路",
      "text": "小蹄虽小，仍可向前。"
    },
    {
      "id": "O002",
      "tag": "安眠",
      "text": "今夜不判平生，困者先眠。"
    },
    {
      "id": "O003",
      "tag": "饭食",
      "text": "若无大事，便好好吃饭。"
    },
    {
      "id": "O004",
      "tag": "烦恼",
      "text": "烦恼若来，众猪咪之。"
    },
    {
      "id": "O005",
      "tag": "自持",
      "text": "不因一时之困，妄断一生之路。"
    },
    {
      "id": "O006",
      "tag": "行路",
      "text": "圣火照路，猪自徐行。"
    },
    {
      "id": "O007",
      "tag": "旧事",
      "text": "今日之猪，不欠昨日解释。"
    },
    {
      "id": "O008",
      "tag": "节律",
      "text": "今日宜慢，不宜乱。"
    },
    {
      "id": "O009",
      "tag": "饭食",
      "text": "腹中有饭，心中方可议天下事。"
    },
    {
      "id": "O010",
      "tag": "安眠",
      "text": "书仍在那里，睡醒再读也不迟。"
    },
    {
      "id": "O011",
      "tag": "行路",
      "text": "路长不怕，怕的是站着替未来发愁。"
    },
    {
      "id": "O012",
      "tag": "自持",
      "text": "做错可改，未成可续。"
    },
    {
      "id": "O013",
      "tag": "烦恼",
      "text": "无解之事，今夜暂不收留。"
    },
    {
      "id": "O014",
      "tag": "自持",
      "text": "猪可迟疑，不可因此轻贱其身。"
    },
    {
      "id": "O015",
      "tag": "行路",
      "text": "今日一步，亦算路程。"
    },
    {
      "id": "O016",
      "tag": "安眠",
      "text": "困意既至，强撑不算英勇。"
    },
    {
      "id": "O017",
      "tag": "饭食",
      "text": "先饭后议，先饱后忧。"
    },
    {
      "id": "O018",
      "tag": "烦恼",
      "text": "猪脑不是客栈，烦恼不得久居。"
    },
    {
      "id": "O019",
      "tag": "自持",
      "text": "证据不足，不准宣布自己完了。"
    },
    {
      "id": "O020",
      "tag": "行路",
      "text": "看路，不看别猪的蹄印排名。"
    },
    {
      "id": "O021",
      "tag": "节律",
      "text": "急事做之，缓事徐行。"
    },
    {
      "id": "O022",
      "tag": "旧事",
      "text": "昨日归昨日，今日立今日。"
    },
    {
      "id": "O023",
      "tag": "自持",
      "text": "诚实承认失误，不必顺手审判整只猪。"
    },
    {
      "id": "O024",
      "tag": "烦恼",
      "text": "想之有益便想，无益便让它飞飞。"
    },
    {
      "id": "O025",
      "tag": "安眠",
      "text": "软被不是退路，是补给站。"
    },
    {
      "id": "O026",
      "tag": "饭食",
      "text": "饭饭饱饱，心心稳稳。"
    },
    {
      "id": "O027",
      "tag": "行路",
      "text": "山高水远，只要小蹄尚动，猪路未断。"
    },
    {
      "id": "O028",
      "tag": "自持",
      "text": "一日之迟，不足以判一生之路。"
    },
    {
      "id": "O029",
      "tag": "烦恼",
      "text": "今日若乱，先把下一件事做好。"
    },
    {
      "id": "O030",
      "tag": "节律",
      "text": "能做则做，不能则缓，未成可续。"
    },
    {
      "id": "O031",
      "tag": "旧事",
      "text": "旧日之猪，只能作证，不能判决。"
    },
    {
      "id": "O032",
      "tag": "行路",
      "text": "明日尚远，今日先行。"
    },
    {
      "id": "O033",
      "tag": "自持",
      "text": "不必时时伟大，先做一只稳当的猪。"
    },
    {
      "id": "O034",
      "tag": "安眠",
      "text": "夜深则歇，天明再战。"
    },
    {
      "id": "O035",
      "tag": "饭食",
      "text": "闻见饭香，是猪道仍在人间的证据。"
    },
    {
      "id": "O036",
      "tag": "烦恼",
      "text": "若今日不顺，先把今日过完。"
    },
    {
      "id": "O037",
      "tag": "行路",
      "text": "慢慢走去，自会抵达该到的地方。"
    },
    {
      "id": "O038",
      "tag": "自持",
      "text": "今日不会之事，不代表来日也不会。"
    },
    {
      "id": "O039",
      "tag": "节律",
      "text": "一事一事来，天地不会因猪慢半拍而塌。"
    },
    {
      "id": "O040",
      "tag": "圣火",
      "text": "圣火不催猪，只照见下一步。"
    }
  ]
}
