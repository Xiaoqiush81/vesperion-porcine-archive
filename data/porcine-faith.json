{
  "title": "猪猪教",
  "english": "THE ORDER OF THE HOLY PORCINE",
  "motto": [
    "圣火昭昭",
    "圣光耀耀",
    "凡我猪者",
    "恩泽滔滔"
  ],
  "intro": "维斯珀里昂宅邸所藏猪教礼仪、圣词与齐诵文本。其义不在苦修，而在护猪、饭猪、眠猪与继续向前。",
  "texts": [
    {
      "id": "zhaozhao",
      "mark": "I",
      "title": "圣词·昭昭篇",
      "kicker": "THE LUMINOUS CREED",
      "lines": [
        "圣火昭昭，圣光耀耀。",
        "圣猪在上，金蹄煌煌。",
        "",
        "凡我猪者，同心，同德，同饭，同眠。",
        "凡我猪者，不畏风雨，不惧路长，",
        "不因一时之困，便折一生之志。",
        "",
        "圣火不灭，猪道不绝。",
        "今日有猪，明日亦有猪。",
        "",
        "一猪倒下，众猪扶之。",
        "一猪饥饿，众猪饭之。",
        "一猪困顿，众猪被之。",
        "一猪烦忧，众猪咪之。",
        "",
        "凡我猪者，皆受圣光。",
        "凡我猪者，皆有其路。",
        "凡我猪者，皆不可轻贱其身。",
        "凡我猪者，皆不可妄断其命。",
        "",
        "天可高，地可远。",
        "山可万重，水可千道。",
        "只要小蹄尚能向前，猪路便未曾断绝。",
        "",
        "昨日之猪，归于昨日。",
        "今日之猪，立于今日。",
        "明日之猪，尚在前方。",
        "",
        "圣火照我猪心，圣光引我猪路。",
        "饭在前方，床在后方。",
        "天地之间，皆可为猪道场。"
      ],
      "group": "圣词"
    },
    {
      "id": "hymn",
      "mark": "II",
      "title": "圣猪颂",
      "kicker": "HYMN OF THE HOLY PIG",
      "lines": [
        "圣猪昭昭，圣光耀耀。",
        "金蹄踏踏，卷尾摇摇。",
        "",
        "晨雾渺渺，天门杳杳。",
        "一猪降世，万物悄悄。",
        "",
        "猪鼻嗅嗅，嘉谷饶饶。",
        "猪耳动动，春风袅袅。",
        "",
        "其腹圆圆，其卧陶陶。",
        "不争不竞，自在逍遥。",
        "",
        "世人扰扰，尘事劳劳。",
        "小猪不语，卧看云高。",
        "",
        "若有烦忧，飞飞了了。",
        "若有饥馑，饭饭饱饱。",
        "",
        "猪德巍巍，猪道迢迢。",
        "圣蹄所至，百草夭夭。",
        "",
        "咪咪咪咪——",
        "咪咪咪咪——",
        "咪咪咪咪！"
      ],
      "group": "赞颂"
    },
    {
      "id": "arrival",
      "mark": "III",
      "title": "迎猪辞",
      "kicker": "RITE OF ARRIVAL",
      "lines": [
        "天门昭昭，晨光熹熹。",
        "清风既至，瑞草离离。",
        "",
        "远闻蹄响，近见猪仪。",
        "小耳微动，卷尾低垂。",
        "",
        "众猪肃立，莫语莫嬉。",
        "扫栏以待，备饭以祈。",
        "",
        "圣猪来兮，圣猪来兮。",
        "饭已温兮，被已齐兮。",
        "烦忧退兮，困苦离兮。",
        "今日诸事，皆可咪兮。"
      ],
      "group": "礼仪"
    },
    {
      "id": "night",
      "mark": "IV",
      "title": "晚猪祝",
      "kicker": "VESPER BENEDICTION",
      "lines": [
        "日已西沉，灯火初明。",
        "书页将合，万籁渐平。",
        "",
        "今日之事，有成有停。",
        "今日之心，有浊有清。",
        "",
        "做完者已矣，未完者明日再行。",
        "说错之言可忘，走错之路可更。",
        "",
        "今夜不审昨日，今夜不判平生。",
        "只令小猪收好卷尾，卧入软被，闭上眼睛。",
        "",
        "睡睡。睡睡。",
        "明日醒来，仍是好猪。"
      ],
      "group": "礼仪"
    }
  ],
  "articles": [
    {
      "mark": "I",
      "title": "饭不可废",
      "body": "凡我猪者，皆有腹。无故不食，非修行也。若因忧烦而忘食，当先使腹中有物，再论天下大事。"
    },
    {
      "mark": "II",
      "title": "眠不可耻",
      "body": "困者当眠。休息不是退缩，恢复亦非懒惰。睡醒以后，书仍在那里，路亦仍在那里。"
    },
    {
      "mark": "III",
      "title": "猪可犯错",
      "body": "一日之迟，不判一生之路；一时之困，不判此猪无能。做错可改，未成可续。"
    },
    {
      "mark": "IV",
      "title": "猪须继续生长",
      "body": "昨日之猪不可永远判决今日之猪。今日所怕，明日或不再怕；今日不会，来日亦可学会。"
    }
  ],
  "response": [
    "圣火昭昭！",
    "圣光耀耀！",
    "猪德巍巍！",
    "猪道浩浩！",
    "凡我猪者，同心同德！",
    "凡我猪者，同饭同眠！",
    "凡我猪者，不惧路远！",
    "凡我猪者，永不自弃！",
    "咪咪咪咪——！",
    "圣猪不朽！猪道长明！"
  ],
  "membership": {
    "visitorTitle": "尚未入教",
    "visitorText": "路人猪可自由阅经、齐诵与观礼；愿意留下教籍者，可在此完成入教仪式。",
    "joinLabel": "加入猪猪教",
    "oath": [
      "我猪自愿入教。",
      "愿护猪、饭猪、眠猪，不以苦修自夸。",
      "愿昨日归昨日，今日立今日。",
      "圣火昭昭，猪道长明。"
    ],
    "memberTitle": "教籍已立",
    "memberText": "圣火已识别此猪。教籍保存在当前浏览器，并解锁教籍猪专属礼仪。",
    "memberMark": "PORCINE MEMBER · №081",
    "leaveLabel": "退出教籍"
  },
  "memberRites": [
    {
      "title": "内坛应答",
      "kicker": "INNER CHAPEL RESPONSE",
      "lines": [
        "问：圣火何在？",
        "答：在猪心未弃之处。",
        "问：猪道何往？",
        "答：往饭香、软被与明日之路。",
        "问：若猪困顿？",
        "答：众猪扶之。"
      ]
    }
  ]
}
